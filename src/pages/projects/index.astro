---
import { getProjects } from '@/lib/contentful';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import ProjectListing from '@/components/react/ProjectListing';

const projects = await getProjects();

// SEO Meta Data
const title = "Projects - Rishit Reddy";
const description = "Research and course projects in image analysis and machine learning, plus the software I've built along the way.";
---

<ProjectLayout title={title} description={description}>
  <ProjectListing projects={projects} client:load />
</ProjectLayout>
